# AshTL Supabase Cloud Database & Authentication Configuration
# Obtain these credentials from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Administrator email — used only for client-side routing hints.
# Actual admin authorization is enforced by the database (public.profiles.role = 'admin')
# and verified with Supabase Row Level Security (RLS).
# Set the real admin email in the database: SELECT public.set_admin_email('your@email.com');
VITE_ADMIN_EMAIL=your-admin-email@gmail.com
